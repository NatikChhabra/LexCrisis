# API keys - NEVER commit
.env
.env.local
*.key
*.pem

# Python
__pycache__/
.venv/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Test artifacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
test_*.py
test_*.txt
test_*.log
stress_test.py
output.txt

# ...but the real test suite must be tracked. Without this the repository
# cannot contain a test by construction, which is how it reached v1.0.0
# with none.
!tests/
!tests/**/*.py

# Dev files
testsprite_tests/
*.egg-info/

# Outputs
#
# `outputs/*` rather than `outputs/`: git will not descend into an excluded
# DIRECTORY, so a negation under `outputs/` can never re-include anything.
# That is why commit 7bd866c had to *force*-add the eval artifacts, and why the
# traces they derive from were silently never committed at all - `git add`
# appeared to succeed and staged nothing.
outputs/*

# Evidence is tracked. Weights are not.
!outputs/evals/
!outputs/policies/
!outputs/traces/
!outputs/training_metrics.json

# Weights and checkpoints stay excluded - large, and not evidence.
outputs/models/
